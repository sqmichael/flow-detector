# Frontend Configuration (Next.js)
# Copy this to .env.local and fill in the values

# Call Service Configuration
# These tell the browser where to find the call service
# Default: http://localhost:8766
# NEXT_PUBLIC_CALL_SERVICE_PORT=8766
# NEXT_PUBLIC_CALL_SERVICE_URL=http://localhost:8766

# Note: Backend configuration (Twilio, Hume, etc.) is in server/calling/.env
# See server/calling/.env.example for backend setup
