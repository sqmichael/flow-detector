{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '📍 CONTEXT: Check CLAUDE.md for current phase and roadmap. Use TodoWrite to track all tasks. Stay focused on the original request - do not scope creep.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/validate-before-stop.sh"
          }
        ]
      }
    ]
  }
}
