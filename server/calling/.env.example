# Twilio Configuration
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Hume AI Configuration
# Get these from: https://platform.hume.ai
HUME_API_KEY=your_hume_api_key_here
HUME_CONFIG_ID=your_hume_config_id_here

# Your Phone Number (where you want to receive calls)
USER_PHONE_NUMBER=+1234567890

# Optional: Custom port for call service (default: 8766)
# CALL_SERVICE_PORT=8766

# Frontend Configuration (Next.js)
# These are read by the browser, so they must be prefixed with NEXT_PUBLIC_
# If you change CALL_SERVICE_PORT above, you must also set NEXT_PUBLIC_CALL_SERVICE_PORT
# Or you can set the full URL with NEXT_PUBLIC_CALL_SERVICE_URL
# NEXT_PUBLIC_CALL_SERVICE_PORT=8766
# NEXT_PUBLIC_CALL_SERVICE_URL=http://localhost:8766
